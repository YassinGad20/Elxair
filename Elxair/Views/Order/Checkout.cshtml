@{
    ViewData["Title"] = "Checkout";
}

<section class="elx-section">
    <div class="elx-eyebrow">Almost There</div>
    <h2 class="elx-section-title" style="color:#2c1712;">Delivery Details</h2>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            @if (TempData["Error"] != null)
            {
                <div class="elx-alert elx-alert-danger mb-4">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }

            <div class="elx-card">
                <div class="elx-card-body p-4 p-md-5">

                    <div style="font-size:0.65rem;letter-spacing:3px;text-transform:uppercase;
                                color:var(--gold);margin-bottom:24px;font-weight:500;">
                        <i class="bi bi-geo-alt me-2"></i>Where Should We Deliver?
                    </div>

                    <form asp-controller="Order" asp-action="CreateOrder" method="post">

                        <div class="mb-3">
                            <label class="elx-label">Full Name</label>
                            <input name="fullName" type="text" class="elx-input"
                                   placeholder="e.g. Mohamed Ahmed" required />
                        </div>

                        <div class="mb-3">
                            <label class="elx-label">Phone Number</label>
                            <input name="phone" type="tel" class="elx-input"
                                   placeholder="e.g. 01012345678" required />
                        </div>

                        <div class="mb-3">
                            <label class="elx-label">Governorate</label>
                            <select name="governorate" class="elx-input" required>
                                <option value="">Select Governorate</option>
                                <option>Cairo</option>
                                <option>Giza</option>
                                <option>Alexandria</option>
                                <option>Assiut</option>
                                <option>Sohag</option>
                                <option>Qena</option>
                                <option>Luxor</option>
                                <option>Aswan</option>
                                <option>Minya</option>
                                <option>Beni Suef</option>
                                <option>Fayoum</option>
                                <option>Sharqia</option>
                                <option>Dakahlia</option>
                                <option>Gharbia</option>
                                <option>Monufia</option>
                                <option>Qalyubia</option>
                                <option>Beheira</option>
                                <option>Kafr El Sheikh</option>
                                <option>Damietta</option>
                                <option>Port Said</option>
                                <option>Ismailia</option>
                                <option>Suez</option>
                                <option>North Sinai</option>
                                <option>South Sinai</option>
                                <option>Red Sea</option>
                                <option>Matruh</option>
                                <option>New Valley</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="elx-label">Detailed Address</label>
                            <textarea name="address" class="elx-input" rows="3"
                                      placeholder="Street, building number, floor, apartment..."
                                      required></textarea>
                        </div>

                        <div style="display:flex;gap:12px;flex-wrap:wrap;">
                            <button type="submit" class="btn-elx-outline"
                                    style="flex:1;justify-content:center;
                                           background:#2c1712;color:white;padding:14px;">
                                <i class="bi bi-bag-check me-2"></i>Place Order
                            </button>
                            <a asp-controller="Cart" asp-action="Index"
                               class="btn-elx-outline" style="padding:14px 20px;">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</section>