@model IEnumerable<Elxair.Models.Perfume>

@{
    ViewData["Title"] = "Products";
}

<section class="elx-section">
    <div class="elx-eyebrow">Our Collection</div>
    <h2 class="elx-section-title" style="color:#2c1712;">All Perfumes</h2>

    <div class="container mb-5">
        <form asp-controller="Product" asp-action="Index" method="get" class="elx-filter-bar">
            <!-- Search -->
            <div class="elx-filter-item elx-search-item">
                <span>Search</span>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Name or brand..." />
            </div>

            <!-- Gender -->
            <div class="elx-filter-item">
                <span>Gender</span>
                <select name="gender">
                    <option value="">All</option>
                    <option value="Him" selected="@(ViewBag.Gender == "Him")">For Him</option>
                    <option value="Her" selected="@(ViewBag.Gender == "Her")">For Her</option>
                    <option value="Unisex" selected="@(ViewBag.Gender == "Unisex")">Unisex</option>
                </select>
            </div>

            <!-- Category -->
            <div class="elx-filter-item">
                <span>Category</span>
                <select name="categoryId">
                    <option value="">All Categories</option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id" selected="@(ViewBag.CategoryId != null && ViewBag.CategoryId == category.Id)">
                            @category.Name
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="elx-filter-btn">Apply</button>

            <a asp-controller="Product" asp-action="Index" class="elx-filter-clear">Clear</a>
        </form>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center" style="padding:60px 0;">
            <p style="color:#8a6056;">No perfumes available right now.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-lg-3 col-md-6">
                    @await Html.PartialAsync("_ProductCard", p)
                </div>
            }
        </div>
    }
</section>

@section Scripts {
    <script>
               function toggleFavorite(perfumeId, btn) {
            $.ajax({
                url: '@Url.Action("ToggleFavorite", "Product")',
                type: 'POST',
                data: { perfumeId: perfumeId },
                success: function (response) {
                    if (response.success) {
                        const icon = $(btn).find('i');
                        if (response.isFavorite) {
                            // مفضل — قلب أحمر solid
                            icon.removeClass('fa-regular').addClass('fa-solid');
                            icon.css('color', '#e74c3c');
                        } else {
                            // مش مفضل — قلب فاضي
                            icon.removeClass('fa-solid').addClass('fa-regular');
                            icon.css('color', '#4a3728');
                        }
                    } else {
                        window.location.href = '/Account/Login';
                    }
                },
                error: function () {
                    window.location.href = '/Account/Login';
                }
            });
        }
    </script>
}

<style>
    /* الـ Styles الخاصة بالفلتر اللي بعتها */
    .elx-filter-bar {
        max-width: 920px;
        margin: 0 auto;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        background: #fbf7f5;
        border: 1px solid #ead6cf;
        border-radius: 2px;
    }

    .elx-filter-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 160px;
    }

        .elx-filter-item span {
            font-size: 0.68rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #b98d7e;
        }

        .elx-filter-item input, .elx-filter-item select {
            height: 38px;
            background: transparent;
            border: none;
            border-bottom: 1px solid #c9aaa1;
            color: #2c1712;
            outline: none;
            font-size: 0.9rem;
        }

    .elx-search-item {
        min-width: 230px;
    }

    .elx-filter-btn {
        align-self: end;
        height: 38px;
        padding: 0 28px;
        border: 1px solid #2c1712;
        background: #2c1712;
        color: #fff;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .elx-filter-clear {
        align-self: end;
        height: 38px;
        display: flex;
        align-items: center;
        color: #8f5751;
        text-decoration: none;
        font-size: 0.85rem;
    }

        .elx-filter-clear:hover {
            color: #2c1712;
            text-decoration: underline;
        }
</style>