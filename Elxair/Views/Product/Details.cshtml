@using Elxair.Models
@using Elxair.ViewModels

@model ProductDetailsVM

@{
    ViewData["Title"] = "Product Details";
    var perfume = Model.Perfume;
}
<p style="font-size:0.9rem;letter-spacing:2px;text-transform:uppercase;color:var(--brown-3);margin-bottom:20px;">
    @perfume.Brand
</p>
<section class="elx-section">
    <div class="row g-5 align-items-start">

        <div class="col-lg-5">
            <div class="elx-card" style="overflow:hidden;">
                <img src="~/images/perfumes/@perfume.ImageUrl"
                     alt="@perfume.Name"
                     class="elx-card-img"
                     style="height:520px;" />
            </div>
        </div>

        <div class="col-lg-7">

            <div class="elx-badge mb-3">
                @(perfume.Category != null ? perfume.Category.Name : "Perfume")
            </div>

            <h1 style="font-family:'Playfair Display',serif;font-size:3rem;color:#2c1712;margin-bottom:12px;">
                @perfume.Name
            </h1>

            <p style="font-size:0.9rem;letter-spacing:2px;text-transform:uppercase;color:var(--brown-3);margin-bottom:20px;">
                @perfume.Brand
            </p>

            <p style="font-size:1rem;color:#5c3d35;line-height:1.9;max-width:650px;">
                @perfume.Description
            </p>
            <div style="margin-bottom:20px;">
                @switch (perfume.Season)
                {
                    case PerfumeSeason.Summer:
                        <span class="badge rounded-pill"
                              style="background:#f7d774;color:#4d2d00;padding:8px 16px;font-size:.85rem;">
                            ☀ Summer Fragrance
                        </span>
                        break;

                    case PerfumeSeason.Winter:
                        <span class="badge rounded-pill"
                              style="background:#b9d8ff;color:#143a66;padding:8px 16px;font-size:.85rem;">
                            ❄ Winter Fragrance
                        </span>
                        break;

                    case PerfumeSeason.AllSeasons:
                        <span class="badge rounded-pill"
                              style="background:#d7f3dc;color:#1d5a2d;padding:8px 16px;font-size:.85rem;">
                            🌤 All Seasons
                        </span>
                        break;
                }
            </div>

            <hr class="elx-divider my-4" />

            <!-- ================= Sizes + Add to Cart (grouped together) ================= -->
            <div class="elx-card p-4 mb-4">

                <h4 style="font-family:'Playfair Display',serif;color:#3a2018;margin-bottom:16px;">
                    Available Sizes
                </h4>

                @if (perfume.Sizes != null && perfume.Sizes.Any())
                {
                    <div class="table-responsive mb-4">
                        <table class="elx-table">
                            <thead>
                                <tr>
                                    <th>Size</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var s in perfume.Sizes)
                                {
                                    <tr>
                                        <td>@s.Size</td>
                                        <td>
                                            @{
                                                var promotion = Model.Promotions[s.Id];
                                            }

                                            @if (promotion != null)
                                            {
                                                <span style="text-decoration:line-through;color:#888;">
                                                    @s.Price EGP
                                                </span>

                                                <br />

                                                <span style="font-weight:bold;color:#c28b00;">
                                                    @Model.FinalPrices[s.Id] EGP
                                                </span>

                                                <br />

                                                @if (promotion.PromotionType == PromotionType.Percentage)
                                                {
                                                    <span class="badge bg-danger">
                                                        @Model.DiscountPercentages[s.Id]% OFF
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        @promotion.Value EGP OFF
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                @($"{s.Price} EGP")
                                            }
                                        </td>
                                        <td>@s.Stock</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <form asp-controller="Cart" asp-action="AddToCart" method="post">

                        <div class="mb-3">
                            <label class="elx-label">Select Size</label>

                            <select name="perfumeSizeId"
                                    class="elx-input"
                                    style="max-width:220px;">

                                @foreach (var s in perfume.Sizes)
                                {
                                    <option value="@s.Id">
                                        @s.Size — @s.Price EGP (@s.Stock in stock)
                                    </option>
                                }
                            </select>
                        </div>

                        <input type="hidden" name="quantity" value="1" />

                        <div class="d-flex gap-2 flex-wrap">

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn-elx-outline">
                                Back to Products
                            </a>

                            <button type="submit"
                                    class="btn-elx-outline"
                                    style="background:#2c1712;color:white;">
                                Add to Cart
                            </button>

                        </div>
                    </form>
                }
                else
                {
                    <p style="color:#8a6056;">
                        No sizes available for this perfume.
                    </p>

                    <a asp-controller="Product" asp-action="Index" class="btn-elx-outline">
                        Back to Products
                    </a>
                }

            </div>

        </div>
    </div>
</section>

@{
    var reviews = ViewBag.Reviews as List<Elxair.Models.Review>;
    double avg = ViewBag.AverageRating;
    int count = ViewBag.ReviewCount;
}

<!-- ================= Reviews (all grouped in one consistent block) ================= -->
<section class="elx-section" style="padding-top:10px;">

    <div class="elx-card p-4 mb-4">
        <h3 style="font-family:'Playfair Display',serif;color:#2c1712;margin-bottom:10px;">
            Customer Reviews
        </h3>

        <h4 style="margin-bottom:4px;">⭐ @avg.ToString("0.0") / 5</h4>

        <p style="color:#8a6056;margin-bottom:0;">@count Review(s)</p>
    </div>

    @if (Context.Session.GetString("IsGuest") != "true" && Context.Session.GetInt32("UserId") != null)
    {
        <div class="elx-card p-4 mb-4">

            <h4 style="font-family:'Playfair Display',serif;color:#3a2018;margin-bottom:16px;">
                Write a Review
            </h4>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <form asp-action="AddReview" method="post">

                <input type="hidden" name="perfumeId" value="@perfume.Id" />

                <div class="mb-3">
                    <label class="form-label">Rating</label>

                    <select name="rating" class="form-control" required>
                        <option value="">Select Rating</option>
                        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                        <option value="4">⭐⭐⭐⭐ (4)</option>
                        <option value="3">⭐⭐⭐ (3)</option>
                        <option value="2">⭐⭐ (2)</option>
                        <option value="1">⭐ (1)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Comment</label>

                    <textarea name="comment"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="Share your experience..."></textarea>
                </div>

                <button type="submit" class="btn-elx-outline"
                        style="background:#2c1712;color:white;">
                    Submit Review
                </button>

            </form>

        </div>
    }

    @if (reviews != null && reviews.Any())
    {
        <div class="mb-4">
            @foreach (var review in reviews)
            {
                <div class="elx-card p-3 mb-3">

                    <strong>@review.User.Name</strong>

                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rating)
                            {
                                <span style="color:gold;">★</span>
                            }
                            else
                            {
                                <span style="color:lightgray;">★</span>
                            }
                        }
                    </div>

                    <p class="mt-2">
                        @review.Comment
                    </p>

                    <small>
                        @review.CreatedAt.ToString("dd MMM yyyy")
                    </small>

                </div>
            }
        </div>
    }
    else
    {
        <p style="color:#8a6056;">No reviews yet.</p>
    }

</section>

@{
    var recommendations = ViewBag.Recommendations as List<Elxair.Models.Perfume> ?? new List<Elxair.Models.Perfume>();
}

@if (recommendations.Any())
{
    <section class="elx-section" style="padding-top:20px;">

        <div class="elx-eyebrow">
            Recommended For You
        </div>

        <h2 class="elx-section-title" style="color:#2c1712;">
            You May Also Like
        </h2>

        <div class="row g-4">
            @foreach (var item in recommendations)
            {
                <div class="col-lg-3 col-md-6">
                    @await Html.PartialAsync("_ProductCard", item)
                </div>
            }
        </div>
    </section>
}
