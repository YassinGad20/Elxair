@model Elxair.Models.Perfume

@{
    ViewData["Title"] = "Product Details";
}

<section class="elx-section">
    <div class="row g-5 align-items-start">

        <div class="col-lg-5">
            <div class="elx-card" style="overflow:hidden;">
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="elx-card-img"
                     style="height:520px;" />
            </div>
        </div>

        <div class="col-lg-7">

            <div class="elx-badge mb-3">
                @(Model.Category != null ? Model.Category.Name : "Perfume")
            </div>

            <h1 style="font-family:'Playfair Display',serif;font-size:3rem;color:#2c1712;margin-bottom:12px;">
                @Model.Name
            </h1>

            <p style="font-size:0.9rem;letter-spacing:2px;text-transform:uppercase;color:var(--brown-3);margin-bottom:20px;">
                @Model.Brand
            </p>

            <p style="font-size:1rem;color:#5c3d35;line-height:1.9;max-width:650px;">
                @Model.Description
            </p>

            <hr class="elx-divider my-4" />

            <h4 style="font-family:'Playfair Display',serif;color:#3a2018;margin-bottom:16px;">
                Available Sizes
            </h4>

            @if (Model.Sizes != null && Model.Sizes.Any())
            {
                <div class="table-responsive">
                    <table class="elx-table">
                        <thead>
                            <tr>
                                <th>Size</th>
                                <th>Price</th>
                                <th>Stock</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var s in Model.Sizes)
                            {
                                <tr>
                                    <td>@s.Size</td>
                                    <td>@s.Price EGP</td>
                                    <td>@s.Stock</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p style="color:#8a6056;">
                    No sizes available for this perfume.
                </p>
            }

            <div style="margin-top:28px;display:flex;gap:14px;flex-wrap:wrap;">

                <form asp-controller="Cart"
                      asp-action="AddToCart"
                      method="post">

                    @if (Model.Sizes != null && Model.Sizes.Any())
                    {
                        <div class="mb-3">
                            <a href="C:\Users\c.delivery for lap\Downloads\one of my faves  Bombshell VS _3.jfif">C:\Users\c.delivery for lap\Downloads\one of my faves  Bombshell VS _3.jfif</a>
                            <label class="elx-label">Select Size</label>

                            <select name="perfumeSizeId"
                                    class="elx-input"
                                    style="max-width:220px;">

                                @foreach (var s in Model.Sizes)
                                {
                                    <option value="@s.Id">
                                        @s.Size — @s.Price EGP (@s.Stock in stock)
                                    </option>
                                }
                            </select>
                        </div>
                    }

                    <input type="hidden" name="quantity" value="1" />

                    <div class="d-flex gap-2 flex-wrap">

                        <a asp-controller="Product"
                               asp-action="Index"
                               class="btn-elx-outline">
                            Back to Products
                        </a>

                        <button type="submit"
                                class="btn-elx-outline"
                                style="background:#2c1712;color:white;">
                            Add to Cart
                        </button>

                    </div>
                </form>

            </div>

        </div>
    </div>
</section>
@{
    var recommendations = ViewBag.Recommendations as List<Elxair.Models.Perfume> ?? new List<Elxair.Models.Perfume>();
}

@if (recommendations.Any())
{
    <section class="elx-section" style="padding-top:20px;">

        <div class="elx-eyebrow">
            Recommended For You
        </div>

        <h2 class="elx-section-title" style="color:#2c1712;">
            You May Also Like
        </h2>

        <div class="row g-4">
            @foreach (var item in recommendations)
            {
                <div class="col-lg-3 col-md-6">
                    @await Html.PartialAsync("_ProductCard", item)
                </div>
            }
        </div>
    </section>
}