@model Elxair.Models.BusinessAnalyticsReport
@{
    ViewData["Title"] = "Business Analytics";
    Layout = "_Layout";

    // NOTE: this view assumes DashboardPredictionResult exposes a product name
    // via "PerfumeName". If your property is actually named "ProductName" or
    // "Name", do a find/replace on "PerfumeName" below.

    var top = Model.Top10Products ?? new List<Elxair.Models.DashboardPredictionResult>();
    var categories = Model.Categories ?? new List<Elxair.Models.CategoryAnalytics>();
    var genders = Model.Genders ?? new List<Elxair.Models.GenderAnalytics>();
    var sizes = Model.Sizes ?? new List<Elxair.Models.SizeAnalytics>();

    var avgProfitPerProduct = Model.TotalProductsCount > 0 ? Model.TotalPredictedProfit / Model.TotalProductsCount : 0;
    var avgUnitsPerProduct = Model.TotalProductsCount > 0 ? (decimal)Model.TotalPredictedUnits / Model.TotalProductsCount : 0;

    var topCategory = categories.OrderByDescending(c => c.TotalProfit).FirstOrDefault();
    var weakCategory = categories.OrderBy(c => c.TotalProfit).FirstOrDefault();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
    :root {
        --ba-bg: #FBF7F1;
        --ba-card: #FFFFFF;
        --ba-border: #EAE0D2;
        --ba-text: #2E2118;
        --ba-text-soft: #5B4E42;
        --ba-muted: #9C8C79;
        --ba-gold: #B8935B;
        --ba-gold-dark: #8F6F40;
        --ba-gold-bg: #F6EEE1;
        --ba-rose: #C77B82;
        --ba-rose-bg: #FBEEEF;
        --ba-sage: #7C9583;
        --ba-sage-bg: #EEF3EE;
        --ba-shadow: 0 4px 24px rgba(46,33,24,0.06);
        --ba-shadow-hover: 0 10px 32px rgba(46,33,24,0.10);
        --ba-radius: 14px;
    }

    .ba-wrap {
        background: var(--ba-bg);
        color: var(--ba-text);
        font-family: 'Poppins',sans-serif;
        font-weight: 400;
        padding: 48px 0 80px;
    }

        .ba-wrap .container-xl {
            max-width: 1360px;
        }

    .ba-eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        letter-spacing: 2.5px;
        color: var(--ba-gold-dark);
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .ba-breadcrumb {
        font-size: 12px;
        letter-spacing: 1px;
        color: var(--ba-muted);
        text-transform: uppercase;
        margin-bottom: 18px;
    }

        .ba-breadcrumb a {
            color: var(--ba-muted);
            text-decoration: none;
        }

            .ba-breadcrumb a:hover {
                color: var(--ba-gold-dark);
            }

        .ba-breadcrumb .sep {
            margin: 0 8px;
            opacity: .5;
        }

        .ba-breadcrumb .current {
            color: var(--ba-text-soft);
        }

    .ba-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 40px;
        padding-bottom: 28px;
        border-bottom: 1px solid var(--ba-border);
    }

    .ba-title {
        font-family: 'Playfair Display',serif;
        font-weight: 600;
        font-size: 2.6rem;
        margin: 0 0 6px;
        letter-spacing: .3px;
    }

    .ba-subtitle {
        color: var(--ba-muted);
        font-size: 14px;
        letter-spacing: .4px;
        margin: 0;
    }

    .ba-refresh-note {
        font-size: 11px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--ba-muted);
        border: 1px solid var(--ba-border);
        padding: 8px 16px;
        border-radius: 30px;
        background: var(--ba-card);
        white-space: nowrap;
    }

        .ba-refresh-note b {
            color: var(--ba-gold-dark);
            font-weight: 600;
        }

    /* Section headings */
    .ba-section-eyebrow {
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--ba-gold-dark);
        margin-bottom: 4px;
        font-weight: 500;
    }

    .ba-section-title {
        font-family: 'Playfair Display',serif;
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0 0 24px;
    }

    /* Cards */
    .ba-card {
        background: var(--ba-card);
        border: 1px solid var(--ba-border);
        border-radius: var(--ba-radius);
        box-shadow: var(--ba-shadow);
        transition: box-shadow .25s ease, transform .25s ease;
    }

        .ba-card:hover {
            box-shadow: var(--ba-shadow-hover);
            transform: translateY(-2px);
        }

    .ba-card-body {
        padding: 26px;
    }

    /* KPI cards */
    .ba-kpi {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 24px;
        height: 100%;
    }

    .ba-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ba-kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ba-gold-bg);
        color: var(--ba-gold-dark);
        flex-shrink: 0;
    }

        .ba-kpi-icon svg {
            width: 20px;
            height: 20px;
        }

    .ba-badge {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .3px;
        padding: 4px 10px;
        border-radius: 20px;
    }

        .ba-badge.up {
            background: var(--ba-sage-bg);
            color: var(--ba-sage);
        }

        .ba-badge.down {
            background: var(--ba-rose-bg);
            color: var(--ba-rose);
        }

        .ba-badge.neutral {
            background: var(--ba-gold-bg);
            color: var(--ba-gold-dark);
        }

    .ba-kpi-value {
        font-family: 'Playfair Display',serif;
        font-size: 1.9rem;
        font-weight: 700;
        line-height: 1.1;
        word-break: break-word;
    }

    .ba-kpi-label {
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--ba-muted);
    }

    .ba-kpi-sub {
        font-size: 12.5px;
        color: var(--ba-text-soft);
        margin-top: -6px;
    }

    /* Tables */
    .ba-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

        .ba-table thead th {
            text-align: left;
            font-size: 11px;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--ba-muted);
            font-weight: 600;
            padding: 10px 14px;
            border-bottom: 1px solid var(--ba-border);
        }

        .ba-table tbody td {
            padding: 13px 14px;
            border-bottom: 1px solid #F3EDE3;
            color: var(--ba-text-soft);
            vertical-align: middle;
        }

        .ba-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ba-table tbody tr:nth-child(even) {
            background: #FCFAF6;
        }

        .ba-table tbody tr {
            transition: background .15s ease;
        }

            .ba-table tbody tr:hover {
                background: var(--ba-gold-bg);
            }

        .ba-table td.num, .ba-table th.num {
            text-align: right;
        }

    .ba-cell-strong {
        color: var(--ba-text);
        font-weight: 600;
    }

    .ba-rank {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 8px;
        font-size: 11.5px;
        font-weight: 700;
        background: var(--ba-gold-bg);
        color: var(--ba-gold-dark);
    }

        .ba-rank.top3 {
            background: var(--ba-gold);
            color: #fff;
        }

    .ba-pill {
        display: inline-block;
        font-size: 11px;
        letter-spacing: .3px;
        padding: 3px 10px;
        border-radius: 20px;
        border: 1px solid var(--ba-border);
        color: var(--ba-text-soft);
        background: #FCFAF6;
    }

    .ba-profit {
        color: var(--ba-gold-dark);
        font-weight: 600;
    }

    /* Chart wrap */
    .ba-chart-box {
        position: relative;
        width: 100%;
    }

    /* Insight cards */
    .ba-insight {
        display: flex;
        gap: 14px;
        padding: 22px;
        height: 100%;
    }

    .ba-insight-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--ba-rose-bg);
        color: var(--ba-rose);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .ba-insight-icon svg {
            width: 18px;
            height: 18px;
        }

    .ba-insight-title {
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .8px;
        color: var(--ba-muted);
        margin-bottom: 4px;
    }

    .ba-insight-body {
        font-family: 'Playfair Display',serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--ba-text);
        line-height: 1.35;
    }

    .ba-insight-note {
        font-size: 12.5px;
        color: var(--ba-text-soft);
        margin-top: 6px;
    }

    /* Quick stats */
    .ba-stat {
        text-align: center;
        padding: 22px 14px;
    }

    .ba-stat-value {
        font-family: 'Playfair Display',serif;
        font-size: 1.7rem;
        font-weight: 700;
        color: var(--ba-gold-dark);
    }

    .ba-stat-label {
        font-size: 11.5px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--ba-muted);
        margin-top: 4px;
    }

    .ba-divider-label {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 56px 0 24px;
    }

        .ba-divider-label .line {
            flex: 1;
            height: 1px;
            background: var(--ba-border);
        }

        .ba-divider-label span {
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--ba-gold-dark);
            white-space: nowrap;
        }

    .ba-legend {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .ba-legend-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
    }

    .ba-legend-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ba-legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .ba-legend-val {
        color: var(--ba-text-soft);
    }

    @@media (max-width: 767px) {
        .ba-title {
            font-size: 2rem;
        }

        .ba-header {
            align-items: flex-start;
        }
    }
</style>

<div class="ba-wrap">
    <div class="container-xl">

        <div class="ba-breadcrumb">
            <a href="/Admin/Dashboard">Home</a><span class="sep">/</span>
            <a href="/Admin/Dashboard">Admin</a><span class="sep">/</span>
            <a asp-action="GenerateReport"
               class="btn btn-dark">
                Generate Report
            </a><span class="sep">/</span>
            <span class="current">Business Analytics</span>
        </div>

        <div class="ba-header">
            <div>
                <div class="ba-eyebrow">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18" /><path d="m19 9-5 5-4-4-3 3" /></svg>
                    Analytics
                </div>
                <h1 class="ba-title">Business Analytics Dashboard</h1>
                <p class="ba-subtitle">AI-Powered Business Insights &amp; Sales Forecast</p>
            </div>
            <div class="ba-refresh-note">Forecast period &nbsp;<b>@DateTime.Now.ToString("MMMM yyyy")</b></div>
        </div>

        <!-- KPI CARDS -->
        <div class="row g-3 mb-2">
            <div class="col-6 col-lg-4 col-xl-2">
                <div class="ba-card h-100">
                    <div class="ba-kpi">
                        <div class="ba-kpi-top">
                            <div class="ba-kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg></div>
                            <span class="ba-badge up">Forecast</span>
                        </div>
                        <div>
                            <div class="ba-kpi-value">@Model.TotalPredictedProfit.ToString("C0")</div>
                            <div class="ba-kpi-label">Total Predicted Profit</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-4 col-xl-2">
                <div class="ba-card h-100">
                    <div class="ba-kpi">
                        <div class="ba-kpi-top">
                            <div class="ba-kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" /><path d="m3.3 7 8.7 5 8.7-5M12 22V12" /></svg></div>
                            <span class="ba-badge neutral">Units</span>
                        </div>
                        <div>
                            <div class="ba-kpi-value">@Model.TotalPredictedUnits.ToString("N0")</div>
                            <div class="ba-kpi-label">Predicted Units Sold</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-4 col-xl-2">
                <div class="ba-card h-100">
                    <div class="ba-kpi">
                        <div class="ba-kpi-top">
                            <div class="ba-kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 2 2.6 6.6L22 9l-5.5 4.7L18.2 22 12 17.9 5.8 22l1.7-8.3L2 9l7.4-.4Z" /></svg></div>
                            <span class="ba-badge up">Best</span>
                        </div>
                        <div>
                            <div class="ba-kpi-value" style="font-size:1.25rem;">@(Model.TopPerformer?.PerfumeName ?? "—")</div>
                            <div class="ba-kpi-label">Best Performing Product</div>
                        </div>
                        @if (Model.TopPerformer != null)
                        {
                            <div class="ba-kpi-sub">@Model.TopPerformer.PredictedProfit.ToString("C0") predicted profit</div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-4 col-xl-2">
                <div class="ba-card h-100">
                    <div class="ba-kpi">
                        <div class="ba-kpi-top">
                            <div class="ba-kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22 9.4 15.4 3 12l6.4-2.6L12 3l2.6 6.4L21 12l-6.4 2.6Z" opacity="0.4" /><path d="M12 22 9.4 15.4 3 12l6.4-2.6L12 3l2.6 6.4L21 12l-6.4 2.6Z" transform="rotate(180 12 12)" /></svg></div>
                            <span class="ba-badge down">Watch</span>
                        </div>
                        <div>
                            <div class="ba-kpi-value" style="font-size:1.25rem;">@(Model.LowestPerformer?.PerfumeName ?? "—")</div>
                            <div class="ba-kpi-label">Lowest Performing Product</div>
                        </div>
                        @if (Model.LowestPerformer != null)
                        {
                            <div class="ba-kpi-sub">@Model.LowestPerformer.PredictedProfit.ToString("C0") predicted profit</div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-4 col-xl-2">
                <div class="ba-card h-100">
                    <div class="ba-kpi">
                        <div class="ba-kpi-top">
                            <div class="ba-kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></div>
                        </div>
                        <div>
                            <div class="ba-kpi-value">@categories.Count</div>
                            <div class="ba-kpi-label">Total Categories</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-4 col-xl-2">
                <div class="ba-card h-100">
                    <div class="ba-kpi">
                        <div class="ba-kpi-top">
                            <div class="ba-kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h9l3 4-8 14L2 7Z" /><path d="M2 7h18M9 3l2 4-2 14M15 3l-2 4 2 14" /></svg></div>
                        </div>
                        <div>
                            <div class="ba-kpi-value">@sizes.Count</div>
                            <div class="ba-kpi-label">Total Bottle Sizes</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CATEGORY ANALYTICS -->
        <div class="ba-divider-label"><div class="line"></div><span>Category Performance</span><div class="line"></div></div>
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="ba-card h-100">
                    <div class="ba-card-body">
                        <div class="ba-section-eyebrow">Breakdown</div>
                        <div class="ba-section-title" style="margin-bottom:16px;">By Category</div>
                        <table class="ba-table">
                            <thead>
                                <tr><th>Category</th><th class="num">Units</th><th class="num">Profit</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in categories)
                                {
                                    <tr>
                                        <td class="ba-cell-strong">@c.CategoryName</td>
                                        <td class="num">@c.TotalUnits.ToString("N0")</td>
                                        <td class="num ba-profit">@c.TotalProfit.ToString("C0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="ba-card h-100">
                    <div class="ba-card-body">
                        <div class="ba-section-eyebrow">Comparison</div>
                        <div class="ba-section-title" style="margin-bottom:16px;">Profit by Category</div>
                        <div class="ba-chart-box" style="height:280px;"><canvas id="categoryProfitChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- GENDER ANALYTICS -->
        <div class="ba-divider-label"><div class="line"></div><span>Audience Split</span><div class="line"></div></div>
        <div class="row g-3">
            <div class="col-lg-5">
                <div class="ba-card h-100">
                    <div class="ba-card-body">
                        <div class="ba-section-eyebrow">Distribution</div>
                        <div class="ba-section-title" style="margin-bottom:16px;">By Gender</div>
                        <div class="ba-chart-box" style="height:240px;"><canvas id="genderDonutChart"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="ba-card h-100">
                    <div class="ba-card-body">
                        <div class="ba-section-eyebrow">Summary</div>
                        <div class="ba-section-title" style="margin-bottom:16px;">Gender Profit &amp; Units</div>
                        <table class="ba-table">
                            <thead>
                                <tr><th>Gender</th><th class="num">Units</th><th class="num">Profit</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var g in genders)
                                {
                                    <tr>
                                        <td class="ba-cell-strong">@g.Gender</td>
                                        <td class="num">@g.TotalUnits.ToString("N0")</td>
                                        <td class="num ba-profit">@g.TotalProfit.ToString("C0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- SIZE ANALYTICS -->
        <div class="ba-divider-label"><div class="line"></div><span>Bottle Size Performance</span><div class="line"></div></div>
        <div class="row g-3">
            <div class="col-12">
                <div class="ba-card">
                    <div class="ba-card-body">
                        <div class="ba-section-eyebrow">Units &amp; Profit</div>
                        <div class="ba-section-title" style="margin-bottom:16px;">By Bottle Size</div>
                        <div class="ba-chart-box" style="height:300px;"><canvas id="sizeBarChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TOP 10 PRODUCTS -->
        <div class="ba-divider-label"><div class="line"></div><span>Top 10 Predicted Products</span><div class="line"></div></div>
        <div class="ba-card">
            <div class="ba-card-body">
                <div class="table-responsive">
                    <table class="ba-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Product</th>
                                <th>Size</th>
                                <th>Category</th>
                                <th>Gender</th>
                                <th class="num">Qty</th>
                                <th class="num">Profit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (var p in top)
                            {
                                <tr>
                                    <td><span class="ba-rank @(rank <= 3 ? "top3" : "")">@rank</span></td>
                                    <td class="ba-cell-strong">@p.PerfumeName</td>
                                    <td><span class="ba-pill">@p.Size</span></td>
                                    <td>@p.CategoryName</td>
                                    <td>@p.Gender</td>
                                    <td class="num">@p.PredictedQuantity.ToString("N0")</td>
                                    <td class="num ba-profit">@p.PredictedProfit.ToString("C0")</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- INSIGHTS PANEL -->
        <div class="ba-divider-label"><div class="line"></div><span>AI Insights</span><div class="line"></div></div>
        <div class="row g-3">
            <div class="col-md-6 col-xl-3">
                <div class="ba-card h-100">
                    <div class="ba-insight">
                        <div class="ba-insight-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 4 6v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V6l-8-4Z" /></svg></div>
                        <div>
                            <div class="ba-insight-title">Best Category to Promote</div>
                            <div class="ba-insight-body">@(topCategory?.CategoryName ?? "—")</div>
                            @if (topCategory != null)
                            {
                                <div class="ba-insight-note">Highest forecasted profit at @topCategory.TotalProfit.ToString("C0")</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="ba-card h-100">
                    <div class="ba-insight">
                        <div class="ba-insight-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg></div>
                        <div>
                            <div class="ba-insight-title">Highest Expected Revenue</div>
                            <div class="ba-insight-body">@(Model.TopPerformer?.PerfumeName ?? "—")</div>
                            @if (Model.TopPerformer != null)
                            {
                                <div class="ba-insight-note">Projected at @Model.TopPerformer.PredictedProfit.ToString("C0") this period</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="ba-card h-100">
                    <div class="ba-insight">
                        <div class="ba-insight-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" /><path d="M12 9v4M12 17h.01" /></svg></div>
                        <div>
                            <div class="ba-insight-title">Lowest Performing Product</div>
                            <div class="ba-insight-body">@(Model.LowestPerformer?.PerfumeName ?? "—")</div>
                            @if (weakCategory != null)
                            {
                                <div class="ba-insight-note">"@weakCategory.CategoryName" trails the category ranking</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="ba-card h-100">
                    <div class="ba-insight">
                        <div class="ba-insight-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" /></svg></div>
                        <div>
                            <div class="ba-insight-title">Suggested Inventory Focus</div>
                            <div class="ba-insight-body">@(sizes.OrderByDescending(s => s.TotalUnits).FirstOrDefault()?.Size ?? "—")</div>
                            <div class="ba-insight-note">Stock up ahead of forecasted demand this size sees</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUICK STATS -->
        <div class="ba-divider-label"><div class="line"></div><span>Quick Statistics</span><div class="line"></div></div>
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="ba-card">
                    <div class="ba-stat">
                        <div class="ba-stat-value">@avgProfitPerProduct.ToString("C0")</div>
                        <div class="ba-stat-label">Avg. Profit / Product</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ba-card">
                    <div class="ba-stat">
                        <div class="ba-stat-value">@avgUnitsPerProduct.ToString("N1")</div>
                        <div class="ba-stat-label">Avg. Units Sold</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ba-card">
                    <div class="ba-stat">
                        <div class="ba-stat-value">@Model.TotalProductsCount.ToString("N0")</div>
                        <div class="ba-stat-label">Number of Products</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ba-card">
                    <div class="ba-stat">
                        <div class="ba-stat-value">@categories.Count</div>
                        <div class="ba-stat-label">Number of Categories</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    (function () {
        if (typeof Chart === 'undefined') {
            console.error('Chart.js failed to load — check that /lib/chartjs/chart.umd.min.js exists in wwwroot.');
            document.querySelectorAll('.ba-chart-box').forEach(function (box) {
                box.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#9C8C79;font-size:13px;">Chart library not found</div>';
            });
            return;
        }
        var GOLD = '#B8935B', GOLD_DARK = '#8F6F40', ROSE = '#C77B82', SAGE = '#7C9583',
            BROWN = '#5B4E42', SAND = '#D9B384', TEXT_SOFT = '#5B4E42', GRID = '#EFE6D8';
        var PALETTE = [GOLD, ROSE, SAGE, BROWN, SAND, '#A8927A', '#94A9C9', '#C9A6D6'];

        Chart.defaults.font.family = "'Poppins', sans-serif";
        Chart.defaults.color = TEXT_SOFT;
        Chart.defaults.font.size = 12;

        var categoryLabels = @Html.Raw(Json.Serialize(categories.Select(c => c.CategoryName)));
        var categoryProfits = @Html.Raw(Json.Serialize(categories.Select(c => c.TotalProfit)));

        new Chart(document.getElementById('categoryProfitChart'), {
            type: 'bar',
            data: {
                labels: categoryLabels,
                datasets: [{
                    data: categoryProfits,
                    backgroundColor: GOLD,
                    borderRadius: 6,
                    barThickness: 18
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: GRID }, ticks: { callback: v => '$' + v } },
                    y: { grid: { display: false } }
                }
            }
        });

        var genderLabels = @Html.Raw(Json.Serialize(genders.Select(g => g.Gender)));
        var genderProfits = @Html.Raw(Json.Serialize(genders.Select(g => g.TotalProfit)));

        new Chart(document.getElementById('genderDonutChart'), {
            type: 'doughnut',
            data: {
                labels: genderLabels,
                datasets: [{
                    data: genderProfits,
                    backgroundColor: [GOLD, ROSE, SAGE, BROWN],
                    borderColor: '#fff',
                    borderWidth: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 16 } } }
            }
        });

        var sizeLabels = @Html.Raw(Json.Serialize(sizes.Select(s => s.Size)));
        var sizeUnits = @Html.Raw(Json.Serialize(sizes.Select(s => s.TotalUnits)));
        var sizeProfits = @Html.Raw(Json.Serialize(sizes.Select(s => s.TotalProfit)));

        new Chart(document.getElementById('sizeBarChart'), {
            type: 'bar',
            data: {
                labels: sizeLabels,
                datasets: [
                    { label: 'Units', data: sizeUnits, backgroundColor: SAGE, borderRadius: 6, yAxisID: 'y' },
                    { label: 'Profit', data: sizeProfits, backgroundColor: GOLD, borderRadius: 6, yAxisID: 'y1' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { boxWidth: 10, padding: 16 } } },
                scales: {
                    x: { grid: { display: false } },
                    y: { position: 'left', grid: { color: GRID }, title: { display: true, text: 'Units' } },
                    y1: { position: 'right', grid: { display: false }, title: { display: true, text: 'Profit ($)' } }
                }
            }
        });
    })();
</script>
