@{
    ViewData["Title"] = "Admin Dashboard";
}
<section class="elx-section">
    <div class="elx-eyebrow">Administration</div>
    <h2 class="elx-section-title" style="color:#2c1712;">Admin Dashboard</h2>
    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Products</div>
                    <h4 class="elx-card-name">Manage Perfumes</h4>
                    <p style="color:#6b4a42;">Add, edit, delete perfumes and manage sizes.</p>
                    <a class="btn-elx-outline" asp-controller="Admin" asp-action="Products">Go to Products</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Orders</div>
                    <h4 class="elx-card-name">Manage Orders</h4>
                    <p style="color:#6b4a42;">Track customer orders and update status.</p>
                    <a class="btn-elx-outline" asp-controller="Admin" asp-action="Orders">View Orders</a>
                </div>
            </div>
        </div>

        @* Manage Promotions *@
        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Marketing</div>
                    <h4 class="elx-card-name">Manage Promotions</h4>
                    <p style="color:#6b4a42;">Create discounts, flash sales and promotional campaigns.</p>
                    <a class="btn-elx-outline" asp-controller="Promotion" asp-action="Index">View Promotions</a>
                </div>
            </div>
        </div>

        @* Store Insights *@
        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Analytics</div>
                    <h4 class="elx-card-name">Store Insights</h4>
                    <p style="color:#6b4a42;">Sales breakdown, revenue charts, and top performers.</p>
                    <a class="btn-elx-outline" asp-controller="Admin" asp-action="Insight">View Insights</a>
                </div>
            </div>
        </div>

        @* Profit Predictions *@
        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Analytics</div>
                    <h4 class="elx-card-name">Profit Predictions</h4>
                    <p style="color:#6b4a42;">View AI-powered monthly profit analysis for all perfumes.</p>
                    <a class="btn-elx-outline" asp-action="ProfitDashboard" asp-controller="Admin">View Predictions</a>
                </div>
            </div>
        </div>

        @* Business Analytics *@
        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Analytics</div>
                    <h4 class="elx-card-name">Business Analytics</h4>
                    <p style="color:#6b4a42;">Dashboard for business analytics.</p>
                    <a class="btn-elx-outline" asp-controller="Admin" asp-action="BusinessAnalytics">View Business Analytics</a>
                </div>
            </div>
        </div>

        @* Store Reports *@
        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Report</div>
                    <h4 class="elx-card-name">Store Reports</h4>
                    <p style="color:#6b4a42;">Reports about business status.</p>
                    <a class="btn-elx-outline" asp-controller="Admin" asp-action="ReportsHistory">View Reports</a>
                </div>
            </div>
        </div>

        @* Chatbot *@
        <div class="col-md-6 col-lg-4">
            <div class="elx-card">
                <div class="elx-card-body">
                    <div class="elx-card-cat">Chatbot</div>
                    <h4 class="elx-card-name">Elixir Chatbot</h4>
                    <p style="color:#6b4a42;">Talk With Ai Agent About Business.</p>
                    <a class="btn-elx-outline" asp-action="Chatbot" asp-controller="Admin">Talk With Elixir Chatbot</a>
                </div>
            </div>
        </div>

    </div>
</section>
